{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JuryMate",
  "version": "0.2.0",
  "identifier": "com.jurymate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JuryMate — AI 选片搭档",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend/jury-backend.exe": "dist-backend/jury-backend.exe"
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis/SimpChinese.nsh"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Kratosmax/jurymate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNUY0M0UxNkQ3MEQ3RkEKUldUNjEzQnQ0VU5mSURMcW40TjVreEVCaEJLSHp6QjRvRWlsNW5qQUhaajVrZ1hsY0hTQ2Y1SjcK"
    }
  }
}
